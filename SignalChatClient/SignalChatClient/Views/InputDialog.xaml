<Window x:Class="SignalChatClient.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание нового пользователя" Height="200" Width="300">
    <Grid>
        <Label Content="Введите имя нового пользователя:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10"/>
        <TextBox x:Name="InputTextBox" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,55,0,0" Width="280"/>
        <CheckBox x:Name="AdminFlag" Margin="10,85,0,0">Имеет права админа</CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,100,10,10" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-11.049"/>
                    <TranslateTransform/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <Button Content="OK" Width="75" Click="OkButton_Click"  Height="22"/>
            <Button Content="Отмена" Width="75" Margin="5,0,0,0" Click="CancelButton_Click" Height="22"/>
        </StackPanel>
    </Grid>
</Window>
